# Copy to .env and fill in (the app reads it automatically; .env is git-ignored - never commit it). Everything is optional: without a key the solvers, parsers and OCR all still work.
GEMINI_API_KEY=
# GEMINI_MODEL=            # force a model; otherwise the newest Flash model your key can use is picked
# RATE_LIMIT_AI=30         # per IP per hour: /ask and /ladder/explain
# RATE_LIMIT_ANALYZE=200   # per IP per hour: /analyze
