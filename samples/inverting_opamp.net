(export (version "E")
  (components
    (comp (ref "V1") (value "1") (libsource (lib "Simulation_SPICE") (part "VDC")))
    (comp (ref "R1") (value "1k") (libsource (lib "Device") (part "R")))
    (comp (ref "R2") (value "10k") (libsource (lib "Device") (part "R")))
    (comp (ref "U1") (value "LM358") (libsource (lib "Amplifier_Operational") (part "LM358"))))
  (nets
    (net (code "1") (name "/VIN") (node (ref "V1") (pin "1") (pinfunction "+")) (node (ref "R1") (pin "1")))
    (net (code "2") (name "/INV") (node (ref "R1") (pin "2")) (node (ref "R2") (pin "1")) (node (ref "U1") (pin "2") (pinfunction "-")))
    (net (code "3") (name "/OUT") (node (ref "R2") (pin "2")) (node (ref "U1") (pin "1") (pinfunction "~")))
    (net (code "4") (name "GND") (node (ref "V1") (pin "2") (pinfunction "-")) (node (ref "U1") (pin "3") (pinfunction "+")))))
