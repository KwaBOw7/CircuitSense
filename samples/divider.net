(export (version "E")
  (design (source "divider.kicad_sch") (tool "Eeschema 8.0"))
  (components
    (comp (ref "V1") (value "10") (libsource (lib "Simulation_SPICE") (part "VDC") (description "DC voltage source")))
    (comp (ref "R1") (value "4k7") (libsource (lib "Device") (part "R")))
    (comp (ref "R2") (value "4.7k") (libsource (lib "Device") (part "R")))
    (comp (ref "Q1") (value "2N3904") (libsource (lib "Device") (part "Q_NPN_BCE"))))
  (nets
    (net (code "1") (name "/VIN") (node (ref "V1") (pin "1") (pinfunction "+")) (node (ref "R1") (pin "1")))
    (net (code "2") (name "/MID") (node (ref "R1") (pin "2")) (node (ref "R2") (pin "1")) (node (ref "Q1") (pin "2") (pinfunction "B")))
    (net (code "3") (name "GND") (node (ref "R2") (pin "2")) (node (ref "V1") (pin "2") (pinfunction "-")) (node (ref "Q1") (pin "1") (pinfunction "E")))))
